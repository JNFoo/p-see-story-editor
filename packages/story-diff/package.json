{
  "name": "story-diff",
  "version": "1.0.0",
  "description": "Says in plain words what one edit did to a story (\"Add page \u201cThe Cellar\u201d\"). Zero dependencies.",
  "license": "MIT",
  "author": "LFC Foundry",
  "type": "module",
  "main": "dist/story-diff.mjs",
  "module": "dist/story-diff.mjs",
  "types": "index.d.ts",
  "unpkg": "dist/story-diff.min.global.js",
  "jsdelivr": "dist/story-diff.min.global.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./dist/story-diff.mjs"
    },
    "./global": "./dist/story-diff.global.js",
    "./min": "./dist/story-diff.min.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "index.d.ts",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "examples"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lfcfoundry/story-editor.git",
    "directory": "packages/story-diff"
  },
  "homepage": "https://github.com/lfcfoundry/story-editor/tree/main/packages/story-diff",
  "keywords": [
    "diff",
    "undo",
    "history",
    "interactive-fiction",
    "story"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  }
}
